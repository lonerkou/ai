# ==========================================
# 1. 匯入必要的 Keras 模組與函式庫
# ==========================================
from tensorflow import keras
from keras.models import Sequential
from keras.layers import Dense, Flatten
import matplotlib.pyplot as plt

# ==========================================
# 2. 載入 MNIST 手寫數字資料集
# ==========================================
mnist = keras.datasets.mnist
# 載入 60000 筆訓練資料/標籤，以及 10000 筆測試資料/標籤
(train_data, train_label), (test_data, test_label) = mnist.load_data()

# ==========================================
# 3. 檢查資料的形狀 (Shape) 與型態
# ==========================================
print("資料型態:", type(train_data))
print("訓練資料形狀 (圖片數量, 高, 寬):", train_data.shape)
print("訓練標籤形狀:", train_label.shape)
print("測試資料形狀:", test_data.shape)
print("測試標籤形狀:", test_label.shape)
print("-" * 30)

# 印出第一筆資料的真實標籤與原始像素矩陣
print("第一筆資料的標籤:", train_label[0])
print("第一筆資料的像素值陣列 (部分):\n", train_data[0])

# ==========================================
# 4. 視覺化呈現第一筆手寫數字圖片
# ==========================================
plt.imshow(train_data[0], cmap='binary') # 設定為黑白二元色調
plt.title(f"Label: {train_label[0]}")
plt.show()

# ==========================================
# 5. 建立神經網路模型架構 (Sequential)
# ==========================================
model = Sequential()

# 將 28x28 的二維影像攤平為 784 個一維特徵 (input_dim=784)
model.add(Flatten(input_shape=(28, 28)))

# 隱藏層：32 個神經元，激勵函數使用 'relu'
model.add(Dense(32, activation='relu'))

# 輸出層：10 個神經元 (對應數字 0~9)，激勵函數使用 'sigmoid'
model.add(Dense(10, activation='sigmoid'))

# ==========================================
# 6. 編譯模型 (Compile)
# ==========================================
# - optimizer: 最佳化器 ('rmsprop')
# - loss: 適用於整數標籤的多分類損失函數 ('sparse_categorical_crossentropy')
# - metrics: 追蹤指標 ('accuracy')
model.compile(optimizer='rmsprop', 
              loss='sparse_categorical_crossentropy', 
              metrics=['accuracy'])

# ==========================================
# 7. 訓練模型 (Fit)
# ==========================================
# 訓練 20 個週期 (epochs)，每批次 (batch_size) 512 筆資料
model.fit(train_data, train_label, epochs=20, batch_size=512)

# ==========================================
# 8. 評估模型 (Evaluate)
# ==========================================
# 使用測試集評估模型效能
score = model.evaluate(test_data, test_label)
print("測試集上的準確率 (Accuracy):", score[1])
